# Public URL/base path
NEXT_PUBLIC_BASE_PATH=/deepHPI
TURNSTILE_SITE_KEY=replace-me
TURNSTILE_REQUIRED=true
TURNSTILE_SECRET_KEY=replace-me
JOB_OWNER_HMAC_SECRET=replace-with-at-least-32-random-bytes

# Dedicated HPC account/key; keep real values only in the deployment environment
BIOCLUSTER_HOST=cluster.example.edu
BIOCLUSTER_PORT=22
BIOCLUSTER_USER=prediction-service
BIOCLUSTER_KEY_FILE=/absolute/path/to/dedicated-private-key
BIOCLUSTER_HOST_KEY_SHA256=SHA256:replace-with-verified-fingerprint
BIOCLUSTER_REMOTE_SCRIPT=/private/path/deepHPI/deephpi.sl
BIOCLUSTER_REMOTE_TMP_DIR=/private/path/prediction-jobs/deephpi

# Local private job records
PREDICTION_JOB_DIR=/app/data/jobs
PREDICTION_JOB_RETENTION_MS=2592000000
SSH_KEEPALIVE_INTERVAL_MS=15000
SSH_KEEPALIVE_COUNT_MAX=4
PREDICTION_MAX_ACTIVE_JOBS=10
PREDICTION_MAX_ACTIVE_JOBS_PER_CLIENT=2

# Submission limits
MAX_REQUEST_BODY_BYTES=4194304
MAX_ACCESSION_COUNT=100
MAX_ACCESSION_LENGTH=64
PREDICTION_MAX_SEQUENCES_PER_SIDE=500
PREDICTION_MAX_SEQUENCE_LENGTH=50000
PREDICTION_MAX_RESIDUES=2000000
PREDICTION_MAX_CANDIDATE_PAIRS=10000

# Optional email notifications
DEEPHPI_APP_URL=https://tools.example.edu/deepHPI
DEEPHPI_MAIL_FROM=no-reply@example.edu
DEEPHPI_SMTP_HOST=smtp.example.edu
DEEPHPI_SMTP_PORT=587
DEEPHPI_SMTP_USER=
DEEPHPI_SMTP_PASS=
DEEPHPI_SMTP_TLS=true
DEEPHPI_SMTP_SSL=false

# Reverse-proxy boundary
TRUSTED_PROXY_CIDR=127.0.0.1/32
PUBLIC_BIND_ADDRESS=127.0.0.1
